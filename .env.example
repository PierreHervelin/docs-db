# Database
DATABASE_URL="postgresql://docdb:docdb_dev_password@localhost:5432/docdb?sslmode=disable"

# S3 (MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="docdb"
S3_SECRET_KEY="docdb_dev_password"
S3_BUCKET="docdb-uploads"

# JWT
JWT_SECRET="dev_secret_change_in_production_use_openssl_rand_base64_32"
JWT_ACCESS_EXPIRATION="30m"
JWT_REFRESH_EXPIRATION="30d"

# Email (Development: MailHog)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_FROM="noreply@localhost"

# Email (Production: Resend)
# Uncomment and set for production
# RESEND_API_KEY="re_xxxxx"

# App
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Rate Limiting (Production: Upstash Redis)
# Uncomment and set for production
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="xxxxx"
